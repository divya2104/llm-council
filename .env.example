# Copy this file to .env and fill in your own key.
# Get a key at https://openrouter.ai/ (purchase credits or enable auto top-up).
OPENROUTER_API_KEY=sk-or-v1-...

# Postgres connection string backing JD Creator storage (Azure Database for
# PostgreSQL Flexible Server). SSL is required by Flexible Server by default.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
